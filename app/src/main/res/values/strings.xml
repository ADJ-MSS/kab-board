    <string name="ecriture_titre">Writing</string>
    <string name="parler_titre">Write as you speak</string>
    <string name="parler_detail">gh → ɣ, dh → ḍ, kh → x, aa → ɛ, ou → u as you type, in ordinary text fields only. Press delete right after a conversion to get your two letters back. Off by default: it also changes French (« vous » becomes « vus »).</string>
